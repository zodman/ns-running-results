{
  "name": "ns-running-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n pb,vite -c blue,green \"npm:pb\" \"npm:dev:vite\"",
    "dev:vite": "vite",
    "pb": "node scripts/run-pb.js",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "pocketbase": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "vite": "^6.1.0",
    "vitest": "^5.1.1"
  }
}
